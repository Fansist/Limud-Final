# --- Limud env ---
# Copy to .env and fill in. Anything left blank degrades to demo content
# with a visible "AI offline" / "service offline" indicator. We never
# silently fall back to fake content.

# --- Database ---
# Postgres in production. SQLite or local Postgres for dev.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/limud?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Google Gemini (personalization, tutor, feedback drafts) ---
# Used by src/lib/ai/gemini.ts with the fallback chain:
#   gemini-2.5-flash -> 2.0-flash -> 1.5-flash -> flash-latest
# Empty key => offline indicator + demo content. Never silent fake answers.
GEMINI_API_KEY=""

# --- Resend (parent weekly digests, invite emails) ---
RESEND_API_KEY=""
RESEND_FROM="Limud <hello@limud.example>"

# --- Demo mode ---
# When true, ?demo=true on any URL bypasses auth and serves the master demo
# account (Maya/Diego/Priya, French Revolution unit). Always available in
# any env so the product is showable with zero data.
LIMUD_DEMO_ENABLED="true"
